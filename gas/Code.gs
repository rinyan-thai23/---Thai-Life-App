/** タイ暮らし：スプレッドシートに紐づけるGAS。最初は手動運用。 */
const TZ = 'Asia/Bangkok';
function onOpen(){SpreadsheetApp.getUi().createMenu('タイ暮らし').addItem('① 初期シートを作成','setupThaiLife').addItem('② 為替を更新','updateExchangeRates').addItem('③ ラッキーナンバーを更新','updateLuckyNumbers').addItem('④ 休日を更新','updateHolidays').addSeparator().addItem('JSONを書き出す','showExportDialog').addItem('③ データを検証・出力シート更新','runManualExport').addToUi();}
function getBook_(){const id=PropertiesService.getScriptProperties().getProperty('THAI_LIFE_SPREADSHEET_ID');if(!id)throw new Error('setupThaiLifeを先に実行してください。');return SpreadsheetApp.openById(id);}
function setupThaiLife(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('スプレッドシートから拡張機能→Apps Scriptを開いてください。');PropertiesService.getScriptProperties().setProperty('THAI_LIFE_SPREADSHEET_ID',ss.getId());ss.setSpreadsheetTimeZone(TZ);
 createSheet_(ss,'為替',['key','value'],[['thb_jpy',4.6],['usd_thb',33],['is_sample',true],['as_of','']]);
 createSheet_(ss,'ラッキーナンバー',['number','is_sample','date','updated_at'],[['07',true,''],['18',true,''],['63',true,'']]);
 createSheet_(ss,'休日',['date','name_ja','name_en','type','province','source','checked_at'],SEED_HOLIDAYS.map(h=>[h.date,h.name_ja,h.name_en,h.type,h.province,h.source,'2026-10-05']));
 createSheet_(ss,'出力',['key','value'],[]);
 ss.getSheetByName('休日').getRange('A2:A').setNumberFormat('yyyy-mm-dd');ss.getSheetByName('ラッキーナンバー').getRange('A2:A').setNumberFormat('@');
 SpreadsheetApp.getUi().alert('初期設定が完了しました。既存のシートは上書きしていません。為替と数字はサンプルです。');}
function createSheet_(ss,name,headers,rows){if(ss.getSheetByName(name))return;const s=ss.insertSheet(name);s.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e1eff0');s.setFrozenRows(1);if(rows.length){if(name==='ラッキーナンバー')s.getRange(2,1,rows.length,1).setNumberFormat('@');s.getRange(2,1,rows.length,headers.length).setValues(rows.map(r=>Array.from({length:headers.length},(_,i)=>r[i]===undefined?'':r[i])));}s.autoResizeColumns(1,headers.length);}
function rows_(name){const s=getBook_().getSheetByName(name);if(!s)throw new Error(name+'シートがありません。');const rows=s.getDataRange().getValues();return rows.slice(1).filter(r=>r.some(v=>v!==''));}
function bool_(v,label){if(v===true||String(v).toLowerCase()==='true')return true;if(v===false||String(v).toLowerCase()==='false')return false;throw new Error(label+'はTRUEまたはFALSEにしてください。');}
function date_(v,optional){if(v===''||v==null){if(optional)return null;throw new Error('日付が空欄です。');}const value=v instanceof Date?Utilities.formatDate(v,TZ,'yyyy-MM-dd'):String(v).trim();if(!/^\d{4}-\d{2}-\d{2}$/.test(value))throw new Error('日付はYYYY-MM-DDで入力してください：'+value);const date=new Date(value+'T00:00:00Z');if(!Number.isFinite(date.getTime())||date.toISOString().slice(0,10)!==value)throw new Error('存在しない日付です：'+value);return value;}
function buildDaily_(replacements){const read=name=>replacements&&replacements[name]!==undefined?replacements[name]:rows_(name);const map={};read('為替').forEach(r=>map[String(r[0]).trim()]=r[1]);const jpy=Number(map.thb_jpy),thb=Number(map.usd_thb);if(!Number.isFinite(jpy)||jpy<=0||!Number.isFinite(thb)||thb<=0)throw new Error('為替は0より大きい数値にしてください。');const fxSample=bool_(map.is_sample,'為替is_sample');const fxDate=date_(map.as_of,true);if(!fxSample&&!fxDate)throw new Error('実レートにはas_of（日付）が必要です。');
 const luckyRows=read('ラッキーナンバー');if(!luckyRows.length||luckyRows.length>5)throw new Error('ラッキーナンバーは1〜5個にしてください。');const flags=luckyRows.map(r=>bool_(r[1],'数字is_sample'));if(flags.some(v=>v!==flags[0]))throw new Error('数字のis_sampleは全行同じ値にしてください。');const luckyDates=luckyRows.map(r=>date_(r[2],true));if(luckyDates.some(v=>v!==luckyDates[0]))throw new Error('数字の日付は全行同じ値にしてください。');if(!flags[0]&&!luckyDates[0])throw new Error('本番の数字には日付が必要です。');const numbers=luckyRows.map(r=>{const s=String(r[0]).trim();if(!/^\d{1,2}$/.test(s))throw new Error('数字は00〜99で入力してください。');return s.padStart(2,'0');});if(new Set(numbers).size!==numbers.length)throw new Error('ラッキーナンバーが重複しています。');
 const seen=new Set();const holidayRows=read('休日');const holidays=holidayRows.map(r=>{const h={date:date_(r[0],false),name_ja:String(r[1]).trim(),name_en:String(r[2]).trim(),type:String(r[3]).trim(),province:String(r[4]).trim(),source:String(r[5]).trim()};if(!h.name_ja||!h.name_en||!['bank','government','public'].includes(h.type)||!h.province||!/^https:\/\//.test(h.source))throw new Error('休日の名称・区分・対象地域・出典を確認してください。');const key=h.date+'|'+h.type+'|'+h.province;if(seen.has(key))throw new Error('休日が重複しています：'+key);seen.add(key);return h;}).sort((a,b)=>a.date.localeCompare(b.date));const checks=holidayRows.map(r=>date_(r[6],false)).sort();
 return {schema_version:1,updated_at:Utilities.formatDate(new Date(),TZ,"yyyy-MM-dd'T'HH:mm:ssXXX"),fx:{thb_jpy:jpy,usd_thb:thb,is_sample:fxSample,as_of:fxDate,updated_at:map.updated_at||null,source:map.source||null},lucky:{numbers:numbers,is_sample:flags[0],date:luckyDates[0],updated_at:luckyRows[0][3]||null},holiday_years:[...new Set(holidays.map(h=>Number(h.date.slice(0,4))))],holidays_checked_at:checks[0]||null,holidays:holidays};}
function runManualExport(){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const d=buildDaily_();const json=JSON.stringify(d,null,2);if(json.length>45000)throw new Error('データが大きすぎます。休日データの年数を減らしてください。');const s=getBook_().getSheetByName('出力');s.getRange(2,1,2,2).setValues([['updated_at',d.updated_at],['daily_json',json]]);return json;}finally{lock.releaseLock();}}
function showExportDialog(){const json=runManualExport();const b64=Utilities.base64Encode(json,Utilities.Charset.UTF_8);const html='<html><meta name="viewport" content="width=device-width, initial-scale=1"><body style="font:18px sans-serif;padding:24px;line-height:1.8"><h2>daily.jsonを書き出す</h2><p>ダウンロード後、アプリと同じ公開先に配置してください。</p><a download="daily.json" href="data:application/json;charset=utf-8;base64,'+b64+'" style="display:inline-block;background:#135d66;color:white;padding:14px 20px;border-radius:10px;text-decoration:none">JSONをダウンロード</a><p>この操作だけではサンプルURLの表示は変わりません。</p></body></html>';SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(460).setHeight(340),'タイ暮らし データ出力');}
/** 任意：完成後にWebアプリとしてJSON配信する場合。編集・更新は公開URLから実行しない。 */
function doGet(e){try{const s=getBook_().getSheetByName('出力');const json=s.getRange(3,2).getValue();if(!json)throw new Error('未出力');const result=ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);if(e&&e.parameter&&e.parameter.download==='1')result.downloadAsFile('daily.json');return result;}catch(error){return ContentService.createTextOutput(JSON.stringify({error:'データ未準備。管理者が手動出力してください。'})).setMimeType(ContentService.MimeType.JSON);}}

